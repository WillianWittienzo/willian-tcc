// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  Tradicional
  Especial
  Doce
}

enum NomeTamanho {
  Pequena
  Media
  Grande
}

enum StatusPedido {
  Pendente
  EmPreparo
  SaiuParaEntrega
  Entregue
  Cancelado
}

enum PapelUsuario {
  Cliente
  Admin
}

enum NomeBorda {
  Catupiry
  Cheddar
}

model Produto {
  id                 Int              @id @default(autoincrement())
  nome               String
  categoria          Categoria
  description        String
  image              String
  descontoPercentual Int?
  tamanhos           ProdutoTamanho[]
  itensPedido        ItemPedido[]
}

model ProdutoTamanho {
  id        Int         @id @default(autoincrement())
  produtoId Int
  nome      NomeTamanho
  preco     Decimal     @db.Decimal(10, 2)
  ordem     Int

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, nome])
}

model Pedido {
  id          Int          @id @default(autoincrement())
  clienteId   Int?
  nomeCliente String?      @db.VarChar(100)
  telefone    String?      @db.VarChar(11)
  cep         String?      @db.VarChar(8)
  rua         String?      @db.VarChar(150)
  numero      String?      @db.VarChar(20)
  bairro      String?      @db.VarChar(100)
  complemento String?      @db.VarChar(150)
  referencia  String?      @db.VarChar(200)
  valorTotal  Decimal      @db.Decimal(10, 2)
  taxaEntrega Decimal      @db.Decimal(10, 2)
  status      StatusPedido @default(Pendente)
  criadoEm    DateTime     @default(now())
  itens       ItemPedido[]
  cliente     Usuario?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([criadoEm])
  @@index([status, criadoEm])
  @@index([telefone])
}

model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(Cliente)
  criadoEm  DateTime     @default(now())
  pedidos   Pedido[]
  sessoes   Sessao[]
}

model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  usuarioId Int
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model ItemPedido {
  id            Int         @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int?
  nomeProduto   String
  tamanho       NomeTamanho
  quantidade    Int
  precoUnitario Decimal     @db.Decimal(10, 2)
  borda         NomeBorda?
  precoBorda    Decimal     @default(0) @db.Decimal(10, 2)

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([produtoId])
}
