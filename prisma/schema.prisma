// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  Tradicional
  Especial
  Doce
}

enum NomeTamanho {
  Pequena
  Media
  Grande
  Gigante
}

enum MetodoEntrega {
  Entrega
  Retirada
}

enum FormaPagamento {
  Dinheiro
  Cartao
  Pix
  Boleto
}

enum StatusRecebimento {
  Pendente
  Pago
  Falhou
}

enum StatusPedido {
  Pendente
  EmPreparo
  SaiuParaEntrega
  Entregue
  Cancelado
}

enum PapelUsuario {
  Cliente
  Admin
}

enum TipoTokenConta {
  VerificacaoEmail
  RecuperacaoSenha
}

enum NomeBorda {
  Catupiry
  Cheddar
}

model Produto {
  id                 Int              @id @default(autoincrement())
  nome               String
  disponivel         Boolean          @default(true)
  categoria          Categoria
  description        String
  image              String
  descontoPercentual Int?
  tamanhos           ProdutoTamanho[]
  itensPedido        ItemPedido[]
}

model ConfiguracaoFuncionamento {
  id               Int      @id @default(1)
  fechamentoManual Boolean  @default(false)
  atualizadoEm     DateTime @updatedAt
}

model HorarioFuncionamento {
  id         Int     @id @default(autoincrement())
  diaSemana  Int     @unique
  fechado    Boolean @default(false)
  abertura   String  @db.VarChar(5)
  fechamento String  @db.VarChar(5)
}

model ProdutoTamanho {
  id        Int         @id @default(autoincrement())
  produtoId Int
  nome      NomeTamanho
  preco     Decimal     @db.Decimal(10, 2)
  ordem     Int

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, nome])
}

model Pedido {
  id            Int            @id @default(autoincrement())
  clienteId     Int?
  nomeCliente   String?        @db.VarChar(100)
  telefone      String?        @db.VarChar(11)
  cep           String?        @db.VarChar(8)
  rua           String?        @db.VarChar(150)
  numero        String?        @db.VarChar(20)
  bairro        String?        @db.VarChar(100)
  complemento   String?        @db.VarChar(150)
  referencia    String?        @db.VarChar(200)
  valorTotal    Decimal        @db.Decimal(10, 2)
  taxaEntrega   Decimal        @db.Decimal(10, 2)
  metodoEntrega MetodoEntrega?
  status        StatusPedido   @default(Pendente)
  criadoEm      DateTime       @default(now())
  itens         ItemPedido[]
  recebimento   Recebimento?
  cliente       Usuario?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([criadoEm])
  @@index([status, criadoEm])
  @@index([telefone])
}

model Recebimento {
  id             Int               @id @default(autoincrement())
  pedidoId       Int               @unique
  valor          Decimal           @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  precisaTroco   Boolean?
  valorParaTroco Decimal?          @db.Decimal(10, 2)
  valorTroco     Decimal?          @db.Decimal(10, 2)
  status         StatusRecebimento @default(Pendente)
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt
  pedido         Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([criadoEm])
}

model Usuario {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  telefone    String?
  cpf         String?      @unique @db.VarChar(11)
  emailVerificadoEm DateTime?
  cep         String?      @db.VarChar(8)
  rua         String?      @db.VarChar(150)
  numero      String?      @db.VarChar(20)
  bairro      String?      @db.VarChar(100)
  complemento String?      @db.VarChar(150)
  referencia  String?      @db.VarChar(200)
  senhaHash   String
  papel       PapelUsuario @default(Cliente)
  criadoEm    DateTime     @default(now())
  pedidos     Pedido[]
  sessoes     Sessao[]
  tokensConta TokenConta[]
}

model TokenConta {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  tipo      TipoTokenConta
  tokenHash String         @unique @db.VarChar(64)
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([expiraEm])
}

model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  usuarioId Int
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model ItemPedido {
  id            Int         @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int?
  nomeProduto   String
  tamanho       NomeTamanho
  quantidade    Int
  precoUnitario Decimal     @db.Decimal(10, 2)
  borda         NomeBorda?
  precoBorda    Decimal     @default(0) @db.Decimal(10, 2)
  observacao    String?     @db.VarChar(200)

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([produtoId])
}
