{
  "name": "willian-tcc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sqlite": "cross-env DATABASE_PROVIDER=sqlite SQLITE_DATABASE_URL=file:./prisma/local/brasa-quente.db next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/regras.test.ts tests/auth.test.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts && prisma generate --config prisma.sqlite.config.ts",
    "sqlite:generate": "prisma generate --config prisma.sqlite.config.ts",
    "sqlite:init": "npm run sqlite:generate && prisma db push --config prisma.sqlite.config.ts",
    "sqlite:seed": "cross-env DATABASE_PROVIDER=sqlite SQLITE_DATABASE_URL=file:./prisma/local/brasa-quente.db tsx prisma/seed.ts",
    "sqlite:setup": "npm run sqlite:init && npm run sqlite:seed",
    "sqlite:admin": "cross-env DATABASE_PROVIDER=sqlite SQLITE_DATABASE_URL=file:./prisma/local/brasa-quente.db tsx scripts/criarAdmin.ts",
    "sqlite:check": "cross-env DATABASE_PROVIDER=sqlite SQLITE_DATABASE_URL=file:./prisma/local/brasa-quente.db tsx scripts/verificarSqlite.ts",
    "admin:create": "tsx scripts/criarAdmin.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
